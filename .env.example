# Groq API Key for Multimodal Vision and LLM inference
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# data.gov.in API Key for Agmarknet Live Mandi Prices
# Read dynamically at runtime from AGMARKNET_API_KEY (matching Supabase Edge Function secret)
AGMARKNET_API_KEY=579b464db66ec23bdd000001your_api_key_here
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001your_api_key_here

# Agmarknet Data Resource ID on data.gov.in
# Default resource ID for daily market arrivals and prices
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Multimodal Vision Model Name on Groq
# Options: llama-3.2-11b-vision-preview, llama-3.2-90b-vision-preview
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","*"]

















